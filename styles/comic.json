{
  "name": "Comic",
  "description": "Chữ truyện tranh: Bangers, viền đen dày, bóng đổ khối, chữ tượng thanh nằm trong khung nổ răng cưa.",
  "font": "Bangers-Regular.ttf",
  "size": 140,
